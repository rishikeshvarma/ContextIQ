# Copy to .env and fill in. Never commit .env.
# Required: callers send it as the X-API-Key header. Unset means every
# protected route answers 503. Generate one with: openssl rand -hex 32
API_KEY=

GEMINI_API_KEY=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/oauth/discord/callback
DISCORD_BOT_TOKEN=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
